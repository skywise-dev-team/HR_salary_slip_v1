# =================================================================
# Dependencies
# =================================================================
node_modules/
frontend/node_modules/
backend/node_modules/

# =================================================================
# Environment files — never commit real credentials (DB password,
# JWT secret, SMTP credentials, etc.)
# =================================================================
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# =================================================================
# Backend uploads — user-generated content (salary slip PDFs,
# imported Excel files staged for approval, establishment logos and
# signatures). None of this belongs in version control: it's runtime
# data, not source, and can grow very large (thousands of generated
# PDFs). .gitkeep files are kept so the empty folder structure itself
# still exists on a fresh clone.
# =================================================================
backend/uploads/imports/*
backend/uploads/logos/*
backend/uploads/signatures/*
backend/uploads/slips/*
!backend/uploads/imports/.gitkeep
!backend/uploads/logos/.gitkeep
!backend/uploads/signatures/.gitkeep
!backend/uploads/slips/.gitkeep

# =================================================================
# Frontend build output
# =================================================================
frontend/dist/
frontend/build/

# =================================================================
# Logs
# =================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# =================================================================
# OS / editor files
# =================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# =================================================================
# Misc
# =================================================================
*.tmp
.cache/
